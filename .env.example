# Variables de entorno de g360-master-data.
# La app arranca con estos defaults (vacio = comportamiento documentado abajo).
# Ninguna es obligatoria para generar en modo offline con G360_S1_CACHE.

# Clave administrativa del API de stock. Requerida SOLO para:
#   - actualizar_catalogo.bat --auto (upload del catalogo)
#   - leer el universo en vivo cuando no hay G360_S1_CACHE
# Default vacio: el BAT pide la clave al usuario (no la inventa ni falla en silencio).
API_KEY=

# Ruta al JSON local del reporte S1 (ej: ..\g360-stock-api\data\stock_cache.json).
# Default vacio: se consulta el API en vivo. Con valor: modo offline, sin red ni clave.
G360_S1_CACHE=

# Clave de LECTURA del universo de stock. Default: cae a API_KEY
# (el API acepta la misma clave para leer y para subir).
G360_STOCK_API_KEY=

# URL base del API de stock.
# Default en codigo: https://g360-stock-api.onrender.com
G360_STOCK_URL=https://g360-stock-api.onrender.com
